# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ----- Microsoft Entra ID (tenant) -----
TENANT_ID=00000000-0000-0000-0000-000000000000

# ----- Fabric Workspace -----
# Workspace ID can be found in the URL of the workspace home page:
#   https://app.fabric.microsoft.com/groups/<WORKSPACE_ID>/...
WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ----- Warehouse -----
WAREHOUSE_NAME=DWH_Modernization_Demo
# SQL endpoint of the warehouse (Workspace -> Warehouse -> Settings -> SQL connection string)
# Format: xxxxxxx-xxxxxxxx.datawarehouse.fabric.microsoft.com
SQL_ENDPOINT=xxxxxxxx-xxxxxxxx.datawarehouse.fabric.microsoft.com

# ----- Lakehouse -----
LAKEHOUSE_NAME=RawZone

# ----- Service Principal (optional, only for headless automation) -----
# Leave blank for the live demo (we use `az login` interactive).
SP_CLIENT_ID=
SP_CLIENT_SECRET=
